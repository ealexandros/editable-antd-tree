{
  "name": "editable-antd-tree",
  "version": "0.3.0",
  "description": "This is an editable tree react component based on antd.",
  "license": "MIT",
  "keywords": [
    "React",
    "Next",
    "Antd",
    "Editable",
    "Tree"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ealexandros/editable-antd-tree.git"
  },
  "homepage": "https://github.com/ealexandros/editable-antd-tree#readme",
  "bugs": {
    "url": "https://github.com/ealexandros/editable-antd-tree/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./dist/*"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/index.css --minify",
    "build:js": "tsdown",
    "dev": "storybook dev -p 6006",
    "lint:check": "eslint src/** --no-warn-ignored",
    "lint:fix": "eslint --fix src/** --no-warn-ignored",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "NODE_ENV=production bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.2.4",
    "@tailwindcss/cli": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "@types/bun": "1.3.4",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "antd": "6.2.3",
    "eslint": "9.39.2",
    "eslint-plugin-storybook": "10.2.4",
    "husky": "9.1.5",
    "lint-staged": "15.2.9",
    "lucide-react": "0.563.0",
    "postcss": "8.5.6",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.7.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "storybook": "10.2.4",
    "tailwindcss": "4.1.18",
    "tsdown": "0.20.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  },
  "peerDependencies": {
    "antd": "^6.0.0",
    "lucide-react": "^0.563.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml,ejs}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.3.0"
}
